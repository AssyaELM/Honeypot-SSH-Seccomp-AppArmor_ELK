[Unit]
Description=SSH Honeypot Sephony
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/fatimazahra/sephony-ssh
ExecStart=/usr/bin/python3 /home/fatimazahra/sephony-ssh/sephony.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
